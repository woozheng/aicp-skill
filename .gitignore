# ============================================================
# AICP Engine .gitignore
# ============================================================

# 配置文件（含 key / token，不要提交）
aicp.yaml
*.local.yaml
.env
.env.*
!.env.example

# 数据目录（运行时生成，全部忽略）
data/*

# 例外：能力库 data/skills 进版本控制（可生长的资产，不是运行时垃圾）
!data/skills/

# 用户应用（运行时生成，全部忽略，保留目录）
plugins/applications/*
!plugins/applications/.gitkeep
# 例外：_demo 是系统自带的最小全栈范式示例，必须随仓库发布
!plugins/applications/_demo/

# 前端页面（纳入版本控制：console / mcp / tools / system / vendor 等手写页面）
# 例外：www/apps 是运行时生成的应用目录，不跟踪、不提交
# 用 www/apps/* 而非 www/apps/：目录整体被排除时 git 不会进入，放行子目录 _demo 会失效
www/apps/*
# 例外：_demo 是系统自带的最小全栈范式示例，必须随仓库发布
!www/apps/_demo/

# 插件生成的运行时文件
plugins/**/__pycache__/
plugins/**/*.pyc
plugins/**/*.contract.json
plugins/_cache/

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# 日志
logs/
*.log

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# 非项目文件
.clinerules/
scripts/

# 系统
desktop.ini
